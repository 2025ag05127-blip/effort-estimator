    "## 1. Dataset Loading and Exploration\n",
    "\n",
    "**Chosen dataset:** Cats vs Dogs (from TensorFlow Datasets)  \n",
    "- 2 classes, 1000 images per class (≥500 required)  \n",
    "- Image size: 224×224×3 (suitable for transfer learning)  \n",
    "- Train/Test split: 90/10  \n",
    "- Primary metric: **Accuracy** (balanced dataset, both classes equally important)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import required libraries\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import tensorflow as tf\n",
    "from tensorflow import keras\n",
    "from tensorflow.keras import layers, models\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix, classification_report\n",
    "import time\n",
    "import json\n",
    "import platform\n",
    "from datetime import datetime\n",
    "\n",
    "# Set random seeds for reproducibility\n",
    "tf.random.set_seed(42)\n",
    "np.random.seed(42)\n",
    "\n",
    "# Download Cats vs Dogs dataset (1000 per class)\n",
    "import tensorflow_datasets as tfds\n",
    "\n",
    "# Load dataset, take 1000 per class for speed and requirement\n",
    "def load_subset(split, take_per_class=1000):\n",
    "    ds = tfds.load('cats_vs_dogs', split=split, as_supervised=True)\n",
    "    cat_ds = ds.filter(lambda x, y: y == 0).take(take_per_class)\n",
    "    dog_ds = ds.filter(lambda x, y: y == 1).take(take_per_class)\n",
    "    return cat_ds.concatenate(dog_ds)\n",
    "\n",
    "train_raw = load_subset('train[:80%]', take_per_class=1000)   # 2000 images\n",
    "test_raw = load_subset('train[80%:100%]', take_per_class=250) # 500 images (balanced)\n",
    "\n",
    "# Preprocessing: resize and normalize\n",
    "IMG_SIZE = 224\n",
    "def preprocess(image, label):\n",
    "    image = tf.image.resize(image, (IMG_SIZE, IMG_SIZE))\n",
    "    image = tf.cast(image, tf.float32) / 255.0\n",
    "    return image, label\n",
    "\n",
    "train_ds = train_raw.map(preprocess).batch(32).prefetch(tf.data.AUTOTUNE)\n",
    "test_ds = test_raw.map(preprocess).batch(32).prefetch(tf.data.AUTOTUNE)\n",
    "\n",
    "# Count samples\n",
    "train_count = sum(1 for _ in train_raw)\n",
    "test_count = sum(1 for _ in test_raw)\n",
    "n_classes = 2\n",
    "samples_per_class = f\"min: 1000, max: 1000, avg: 1000\"\n",
    "image_shape = [IMG_SIZE, IMG_SIZE, 3]\n",
    "\n",
    "print(\"=\"*70)\n",
    "print(\"DATASET INFORMATION\")\n",
    "print(f\"Dataset: Cats vs Dogs\")\n",
    "print(f\"Source: TensorFlow Datasets (tfds)\")\n",
    "print(f\"Total Samples: {train_count + test_count}\")\n",
    "print(f\"Number of Classes: {n_classes}\")\n",
    "print(f\"Samples per Class: {samples_per_class}\")\n",
    "print(f\"Image Shape: {image_shape}\")\n",
    "print(f\"Primary Metric: accuracy\")\n",
    "print(f\"Metric Justification: Accuracy is chosen because the dataset is perfectly balanced (1000 cats, 1000 dogs) and both classes have equal importance; misclassification cost is symmetric.\")\n",
    "\n",
    "# Visualize sample images\n",
    "plt.figure(figsize=(10,5))\n",
    "for images, labels in train_ds.take(1):\n",
    "    for i in range(6):\n",
    "        ax = plt.subplot(2,3,i+1)\n",
    "        plt.imshow(images[i])\n",
    "        plt.title(\"Cat\" if labels[i]==0 else \"Dog\")\n",
    "        plt.axis('off')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Custom CNN with Global Average Pooling (GAP)\n",
    "\n",
    "Architecture:\n",
    "- Conv2D (32 filters, 3×3) + ReLU + MaxPooling (2×2)\n",
    "- Conv2D (64 filters, 3×3) + ReLU + MaxPooling (2×2)\n",
    "- GlobalAveragePooling2D (MANDATORY – no Flatten/Dense after convs)\n",
    "- Dense (2 units, softmax)\n",
    "\n",
    "**GAP reduces overfitting, drastically reduces parameters, and forces spatial feature learning.**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_custom_cnn(input_shape, n_classes):\n",
    "    model = models.Sequential([\n",
    "        layers.Conv2D(32, (3,3), activation='relu', input_shape=input_shape),\n",
    "        layers.MaxPooling2D(2,2),\n",
    "        layers.Conv2D(64, (3,3), activation='relu'),\n",
    "        layers.MaxPooling2D(2,2),\n",
    "        layers.GlobalAveragePooling2D(),   # GAP – mandatory, no Flatten\n",
    "        layers.Dense(n_classes, activation='softmax')\n",
    "    ])\n",
    "    return model\n",
    "\n",
    "custom_cnn = build_custom_cnn(image_shape, n_classes)\n",
    "custom_cnn.compile(optimizer='adam',\n",
    "                   loss='sparse_categorical_crossentropy',\n",
    "                   metrics=['accuracy'])\n",
    "custom_cnn.summary()\n",
    "\n",
    "# Training\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"CUSTOM CNN TRAINING\")\n",
    "start_time = time.time()\n",
    "history_cnn = custom_cnn.fit(train_ds, epochs=15, validation_data=test_ds, verbose=1)\n",
    "custom_cnn_training_time = time.time() - start_time\n",
    "\n",
    "# Capture initial and final loss\n",
    "custom_cnn_initial_loss = history_cnn.history['loss'][0]\n",
    "custom_cnn_final_loss = history_cnn.history['loss'][-1]\n",
    "\n",
    "print(f\"Training completed in {custom_cnn_training_time:.2f} seconds\")\n",
    "print(f\"Initial Loss: {custom_cnn_initial_loss:.4f}\")\n",
    "print(f\"Final Loss: {custom_cnn_final_loss:.4f}\")\n",
    "print(f\"Loss reduction: {(custom_cnn_initial_loss - custom_cnn_final_loss)/custom_cnn_initial_loss*100:.1f}%\")\n",
    "\n",
    "# Plot training loss curve\n",
    "plt.plot(history_cnn.history['loss'], label='Training Loss')\n",
    "plt.plot(history_cnn.history['val_loss'], label='Validation Loss')\n",
    "plt.title('Custom CNN - Loss Curves')\n",
    "plt.xlabel('Epoch')\n",
    "plt.ylabel('Loss')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate Custom CNN – all 4 metrics\n",
    "# Collect predictions\n",
    "y_true = []\n",
    "y_pred = []\n",
    "for images, labels in test_ds:\n",
    "    preds = custom_cnn.predict(images, verbose=0)\n",
    "    y_true.extend(labels.numpy())\n",
    "    y_pred.extend(np.argmax(preds, axis=1))\n",
    "\n",
    "custom_cnn_accuracy = accuracy_score(y_true, y_pred)\n",
    "custom_cnn_precision = precision_score(y_true, y_pred, average='macro')\n",
    "custom_cnn_recall = recall_score(y_true, y_pred, average='macro')\n",
    "custom_cnn_f1 = f1_score(y_true, y_pred, average='macro')\n",
    "\n",
    "print(\"\\nCustom CNN Performance:\")\n",
    "print(f\"Accuracy:  {custom_cnn_accuracy:.4f}\")\n",
    "print(f\"Precision: {custom_cnn_precision:.4f}\")\n",
    "print(f\"Recall:    {custom_cnn_recall:.4f}\")\n",
    "print(f\"F1-Score:  {custom_cnn_f1:.4f}\")\n",
    "\n",
    "# Confusion matrix\n",
    "cm = confusion_matrix(y_true, y_pred)\n",
    "plt.figure(figsize=(6,5))\n",
    "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=['Cat','Dog'], yticklabels=['Cat','Dog'])\n",
    "plt.title('Custom CNN Confusion Matrix')\n",
    "plt.xlabel('Predicted')\n",
    "plt.ylabel('True')\n",
    "plt.show()"
   ]
  },
